# PocketTill Landing — environment variables
# Copy to .env.local for local dev, and set the same key in Vercel →
# Project Settings → Environment Variables for production.

# GA4 Measurement ID for the gtag.js tracking script (format: G-XXXXXXXXXX).
# Find it in GA4 Admin -> Data Streams -> your web stream -> Measurement ID.
# NOTE: this is different from pockettill_datamaster's GA4_PROPERTY_ID
# ("properties/123456789"), which is the Admin/Data API property number used
# for server-side reporting there, not a gtag Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
