# PocketTill DataMaster — environment variables
# Copy this file to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.
# Never commit .env.local — it holds real secrets and is already gitignored.

# --- Supabase (required) ---
# Public: safe to expose to the browser, used by both client and server code.
NEXT_PUBLIC_SUPABASE_URL=https://jaiaolofdxtsbbsyjvio.supabase.co
# The new-style Supabase publishable key (starts with sb_publishable_...).
# NOT the legacy "anon key" — this project's client helpers read this exact
# variable name (see src/lib/supabase/client.ts, middleware.ts, server.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never referenced by any client component, only by files that
# import "server-only" (src/lib/supabase/server.ts). Bypasses RLS entirely.
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth session secret ---
# Not currently used by this codebase (auth is Supabase Auth via cookies,
# no NextAuth dependency is installed). Listed for completeness in case a
# future integration needs it. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Twilio (Infrastructure Costs page — OTP spend + balance) ---
# Twilio Console → Account → Account Info.
TWILIO_ACCOUNT_SID=
# Twilio Console → Account → Auth Token.
TWILIO_AUTH_TOKEN=
# Twilio Console → Verify → your Verify Service → Service SID.
TWILIO_VERIFY_SID=

# --- Supabase Management API (Infrastructure Costs page — DB size/usage) ---
# Supabase Dashboard → Account → Access Tokens → generate a new token.
SUPABASE_MANAGEMENT_API_KEY=
# The project ref from the project URL above (jaiaolofdxtsbbsyjvio).
SUPABASE_PROJECT_REF=jaiaolofdxtsbbsyjvio

# --- Google Analytics 4 (Website Traffic page) ---
# GA4 Admin → Property Details → Property ID (numeric).
GA4_PROPERTY_ID=
# Google Cloud service account with Viewer access on the GA4 property.
GA4_CLIENT_EMAIL=
# The service account's private key. Paste it with literal \n sequences
# (not real line breaks) — the code unescapes them at runtime. When pasting
# into Vercel's env var UI, keep it as one line wrapped in quotes.
GA4_PRIVATE_KEY=
